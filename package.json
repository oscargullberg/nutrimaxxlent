{
  "name": "nutrimaxxlent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node scripts/start.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && oxlint . && oxfmt --check .",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "demo": "tsx scripts/test-e2e.ts --demo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "data:download": "tsx scripts/catalog.ts download",
    "ingest": "tsx scripts/catalog.ts import",
    "data:refresh": "tsx scripts/catalog.ts refresh",
    "backup": "tsx scripts/backup.ts",
    "provider:smoke": "tsx scripts/provider-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.144",
    "@ai-sdk/provider": "^3.0.19",
    "ai": "^6.0.333",
    "drizzle-orm": "^0.45.4",
    "openai-codex-oauth": "1.0.1",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  }
}
