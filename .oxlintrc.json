{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "env": {
    "node": true,
    "browser": true
  },
  "ignorePatterns": [
    "build/**",
    ".svelte-kit/**",
    "node_modules/**",
    "data/**",
    "openspec/**",
    ".agents/**",
    ".claude/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
